; Engine configuration file.
; 이 파일은 게임플레이 담당(A)만 고친다. CLAUDE.md 참고.

config_version=5

[application]

config/name="The Way Back"
config/description="돌아가는 길 — 할아버지의 지도를 따라 걷는 30분짜리 횡스크롤 어드벤처"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="dog"

[gui]

theme/custom_font="res://assets/fonts/noto_sans_kr_regular_subset.ttf"

